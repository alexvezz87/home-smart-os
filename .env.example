# ============================================================================
# HOME SMART OS - Configurazione Ambiente (.env.example)
# ============================================================================

PORT=3000
NODE_ENV=development
APP_URL=https://home.alexsoluzioniweb.it

# --- Autenticazione & Sicurezza Dashboard ---
AUTH_ENABLED=true
SESSION_SECRET=change_me_with_a_64_char_random_hex_secret
# Chiave crittografica AES-256 (32 bytes / 64 caratteri esadecimali) per protezione token su TiDB Cloud.
# Generabile con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_with_a_32_byte_aes256_secret
ALLOWED_GOOGLE_EMAILS=tuo.indirizzo@gmail.com
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
TABLET_KIOSK_PIN=

# --- Database TiDB Cloud (MySQL Compatible Serverless) ---
DB_CONNECTION=mysql
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=db_home_os
DB_USERNAME=
DB_PASSWORD=
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Meross Cloud (Telemetria Prese Smart & Carichi) ---
MEROSS_EMAIL=
MEROSS_PASSWORD=

# --- Philips Hue Bridge ---
HUE_BRIDGE_IP=192.168.1.18
HUE_API_KEY=

# --- Telecamere TP-Link Tapo (RTSP / ONVIF) ---
TAPO_USER=
TAPO_PASSWORD=
TAPO_CLOUD_PASSWORD=

# --- Caldaia Bosch EasyControl CT200 (SingleKey ID / PointT API) ---
BOSCH_SERIAL_NUMBER=
BOSCH_ACCESS_KEY=
BOSCH_PASSWORD=

# --- Wallbox ABB Terra AC (ChargerSync / ChargeDot) ---
ABB_EMAIL=
ABB_PASSWORD=

# --- Volvo Cars API v2 (Volvo EX30) ---
VOLVO_VIN=
VOLVO_VCC_API_KEY=
VOLVO_CLIENT_ID=
VOLVO_CLIENT_SECRET=
VOLVO_REDIRECT_URI=https://home.alexsoluzioniweb.it/callback

# --- Metadati Utenze (Opzionali per Reportistica) ---
UTILITY_POD=IT001E********
UTILITY_PDR=0088**********
